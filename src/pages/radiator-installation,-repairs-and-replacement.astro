---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { Phone, Shield, CheckCircle, Wrench, Flame, Clock, AlertCircle, DollarSign, MessageCircle, Calendar, Zap, Droplets, Thermometer } from 'lucide-react';
import image1 from "../assets/image/Boiler-Swap-Upgrade.png"
import image2 from "../assets/image/Heating-System-Installation.png"
import image3 from "../assets/image/heaterHero.webp"

// Dynamic data
const serviceData = {
  title: "Radiator Repair and Replacement",
  location: "Your Location",
  businessName: "Your Business Name",
  metaDescription: "Professional radiator repair and replacement in [location]. Expert installation of new radiators and repair of existing systems.",
  phoneNumber: "YOUR-PHONE-NUMBER"
};
---

<Layout title={`Radiator Repair and Replacement in ${serviceData.location} | ${serviceData.businessName}`} description={serviceData.metaDescription}>
  <!-- Hero Section -->
  <section class="relative py-16 md:py-24 bg-gradient-to-r from-blue-900 to-gray-900 text-white overflow-hidden">
    <div class="absolute inset-0 z-0 opacity-20">
    </div>
    
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <div class="mb-4">
            <span class="inline-flex items-center px-4 py-2 rounded-full bg-white/10 backdrop-blur-sm text-white text-sm font-medium border border-white/20">
              <Thermometer className="w-4 h-4 mr-2" />
              Heating Experts
            </span>
          </div>
          
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">
            Radiator Repair and Replacement in <span class="text-orange-400">{serviceData.location}</span>
          </h1>
          
          <p class="text-xl text-gray-300 mb-8 max-w-2xl">
            Expert radiator installation, repair and replacement services. Restore even heating to every room in your home.
          </p>
          
          <div class="flex flex-wrap gap-4">
            <a href={`tel:${serviceData.phoneNumber}`} class="inline-flex items-center px-8 py-4 bg-orange-500 hover:bg-orange-600 text-white font-semibold rounded-lg transition-all duration-300 shadow-lg hover:shadow-xl">
              <Phone className="w-5 h-5 mr-3" />
              Call Now: {serviceData.phoneNumber}
            </a>
            <a href="/contact" class="inline-flex items-center px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-semibold rounded-lg transition-all duration-300 backdrop-blur-sm border border-white/20">
              Book Service Online
            </a>
          </div>
          
          <div class="mt-8 grid grid-cols-2 md:grid-cols-3 gap-4">
            <div class="flex items-center">
              <CheckCircle className="w-5 h-5 text-green-400 mr-2" />
              <span class="text-sm">Same Day Service</span>
            </div>
            <div class="flex items-center">
              <CheckCircle className="w-5 h-5 text-green-400 mr-2" />
              <span class="text-sm">Correct Sizing</span>
            </div>
            <div class="flex items-center">
              <CheckCircle className="w-5 h-5 text-green-400 mr-2" />
              <span class="text-sm">Professional Installation</span>
            </div>
          </div>
        </div>
        
        <div class="relative">
          <div class="relative rounded-xl overflow-hidden shadow-2xl transform hover:scale-[1.02] transition-transform duration-300">
            <Image 
              src={image1} 
              alt="Radiator installation and repair technician at work" 
              width={600}
              height={400}
              class="w-full h-auto"
              loading="eager"
              decoding="async"
            />
          </div>
          <div class="absolute -bottom-4 -left-4 bg-white text-gray-900 p-4 rounded-lg shadow-lg max-w-xs">
            <div class="flex items-center mb-2">
              <Thermometer className="w-5 h-5 text-blue-500 mr-2" />
              <span class="font-semibold">Even Heating Guaranteed</span>
            </div>
            <p class="text-sm">Proper sizing and installation for consistent warmth</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-12">
        <!-- Main Content Column -->
        <div class="lg:col-span-2">
          <!-- Introduction -->
          <div class="prose prose-lg max-w-none mb-12">
            <p class="lead text-xl text-gray-700 mb-8">
              If you're searching for radiator replacement in {serviceData.location}, you want the right radiator fitted properly so the room heats evenly again.
            </p>
            
            <p>
              Maybe your radiator is leaking, cold in spots, taking ages to warm up, rusting, or it's the wrong size for the space and never feels comfortable. {serviceData.businessName} replaces radiators by checking the pipework and room requirements first, explaining the options clearly, and only starting once the plan is agreed.
            </p>
            
            <div class="bg-blue-50 border-l-4 border-blue-500 p-6 my-6 rounded-r-lg">
              <p class="font-semibold text-blue-800">
                The result is a correctly sized, securely fitted, and properly installed radiator that heats consistently and performs as it should.
              </p>
            </div>
            
            <p class="font-semibold text-blue-700">
              Book radiator replacement in {serviceData.location} with {serviceData.businessName}.
            </p>
          </div>

          <!-- Radiator Replacement Overview -->
          <div class="mb-12">
            <h2 class="text-3xl font-bold text-gray-900 mb-6">Radiator Replacement in {serviceData.location}</h2>
            
            <p class="text-gray-700 mb-6">
              Radiator replacement is the process of removing an existing radiator and fitting a new one that matches the room's needs and the existing pipework constraints. Done properly, radiator replacement improves heat output, restores reliability, and removes issues like leaks and corrosion that can worsen over time.
            </p>
            
            <div class="p-6 bg-gray-50 rounded-lg border border-gray-200">
              <p class="text-gray-700">
                <span class="font-semibold">Our Focus:</span> {serviceData.businessName} focuses on radiator replacement that's measured, compatible, and finished cleanly — so the new radiator works correctly from day one.
              </p>
            </div>
          </div>

          <!-- When Replacement is Needed -->
          <div class="mb-12">
            <h2 class="text-3xl font-bold text-gray-900 mb-6">When Radiator Replacement is the Right Choice</h2>
            
            <p class="text-gray-700 mb-6">
              Radiator replacement is commonly needed when:
            </p>
            
            <div class="grid md:grid-cols-2 gap-6">
              <div class="space-y-3">
                <div class="flex items-start">
                  <AlertCircle className="w-5 h-5 text-red-500 mr-3 mt-0.5 flex-shrink-0" />
                  <span>The radiator is leaking or has visible corrosion</span>
                </div>
                <div class="flex items-start">
                  <AlertCircle className="w-5 h-5 text-orange-500 mr-3 mt-0.5 flex-shrink-0" />
                  <span>The radiator has cold spots that never fully improve</span>
                </div>
                <div class="flex items-start">
                  <AlertCircle className="w-5 h-5 text-blue-500 mr-3 mt-0.5 flex-shrink-0" />
                  <span>The radiator output is too low for the room size</span>
                </div>
              </div>
              
              <div class="space-y-3">
                <div class="flex items-start">
                  <AlertCircle className="w-5 h-5 text-purple-500 mr-3 mt-0.5 flex-shrink-0" />
                  <span>The radiator is physically damaged or has failing valves/connections</span>
                </div>
                <div class="flex items-start">
                  <AlertCircle className="w-5 h-5 text-green-500 mr-3 mt-0.5 flex-shrink-0" />
                  <span>You're changing a room layout and need a different radiator size or position</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Image 1: Diagnostic Process -->
          <div class="mb-12">
            <div class="rounded-xl overflow-hidden shadow-lg mb-6">
              <Image 
                src={image2} 
                alt="Radiator assessment and compatibility checks" 
                width={800}
                height={450}
                class="w-full h-auto"
              />
            </div>
            <p class="text-sm text-gray-500 text-center italic">Professional radiator assessment and compatibility checks</p>
          </div>

          <!-- What Replacement Includes -->
          <div class="mb-12">
            <h2 class="text-3xl font-bold text-gray-900 mb-6">What Radiator Replacement Includes</h2>
            
            <p class="text-gray-700 mb-6">
              A radiator replacement service typically includes:
            </p>
            
            <div class="grid md:grid-cols-2 gap-6">
              <div class="space-y-4">
                <div class="flex items-start">
                  <CheckCircle className="w-5 h-5 text-green-500 mr-3 mt-0.5 flex-shrink-0" />
                  <span>Assessing the existing radiator size, position, and pipe spacing</span>
                </div>
                <div class="flex items-start">
                  <CheckCircle className="w-5 h-5 text-green-500 mr-3 mt-0.5 flex-shrink-0" />
                  <span>Confirming the replacement radiator's compatibility and suitability for the room</span>
                </div>
                <div class="flex items-start">
                  <CheckCircle className="w-5 h-5 text-green-500 mr-3 mt-0.5 flex-shrink-0" />
                  <span>Isolating and removing the existing radiator safely</span>
                </div>
              </div>
              
              <div class="space-y-4">
                <div class="flex items-start">
                  <CheckCircle className="w-5 h-5 text-green-500 mr-3 mt-0.5 flex-shrink-0" />
                  <span>Installing the new radiator securely with correct alignment and support</span>
                </div>
                <div class="flex items-start">
                  <CheckCircle className="w-5 h-5 text-green-500 mr-3 mt-0.5 flex-shrink-0" />
                  <span>Reconnecting pipework, valves, and the water supply correctly to ensure proper radiator operation</span>
                </div>
                <div class="flex items-start">
                  <CheckCircle className="w-5 h-5 text-green-500 mr-3 mt-0.5 flex-shrink-0" />
                  <span>Refilling and checking for stable operation at the radiator</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Choosing the Right Radiator -->
          <div class="mb-12">
            <h2 class="text-3xl font-bold text-gray-900 mb-6">Choosing the Right Replacement Radiator</h2>
            
            <p class="text-gray-700 mb-6">
              The "right" radiator is not just about appearance. A good replacement matches the room's heating demand and fits your system constraints.
            </p>
            
            <div class="bg-blue-50 p-6 rounded-lg mb-6">
              <h3 class="font-bold text-gray-900 mb-4">Heat Output Suitability</h3>
              <p class="text-gray-700 mb-4">
                Radiator output needs to suit the room. Oversizing and undersizing both create problems:
              </p>
              <div class="grid md:grid-cols-2 gap-6">
                <div class="p-4 bg-red-50 rounded-lg">
                  <h4 class="font-semibold text-gray-900 mb-2">Too Small</h4>
                  <p class="text-sm text-gray-700">The room never reaches comfort reliably</p>
                </div>
                <div class="p-4 bg-orange-50 rounded-lg">
                  <h4 class="font-semibold text-gray-900 mb-2">Too Large</h4>
                  <p class="text-sm text-gray-700">Heat can feel uneven and less controllable</p>
                </div>
              </div>
              <div class="mt-4 p-4 bg-gray-50 rounded-lg">
                <p class="text-sm text-gray-700">
                  <span class="font-semibold">Important:</span> Adequate hot water flow is essential for the radiator to deliver the intended heat output, ensuring the room is heated efficiently and evenly.
                </p>
              </div>
            </div>
            
            <div class="p-6 bg-green-50 rounded-lg border-l-4 border-green-500">
              <p class="text-gray-700">
                <span class="font-semibold">Expert Guidance:</span> {serviceData.businessName} helps you choose a radiator that makes sense for real-world use in the space.
              </p>
            </div>
          </div>

          <!-- Size, Shape and Placement -->
          <div class="mb-12">
            <h2 class="text-3xl font-bold text-gray-900 mb-6">Size, Shape, and Placement</h2>
            
            <p class="text-gray-700 mb-6">
              Replacement radiators must fit the available wall space while allowing:
            </p>
            
            <div class="grid md:grid-cols-3 gap-6 mb-6">
              <div class="p-4 bg-gray-50 rounded-lg text-center">
                <div class="w-10 h-10 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-3">
                  <Shield className="w-5 h-5 text-gray-600" />
                </div>
                <p class="font-semibold text-gray-900">Safe clearance around the radiator</p>
              </div>
              <div class="p-4 bg-blue-50 rounded-lg text-center">
                <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-3">
                  <Wrench className="w-5 h-5 text-blue-600" />
                </div>
                <p class="font-semibold text-gray-900">Practical access to valves</p>
              </div>
              <div class="p-4 bg-green-50 rounded-lg text-center">
                <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-3">
                  <Thermometer className="w-5 h-5 text-green-600" />
                </div>
                <p class="font-semibold text-gray-900">A stable, level installation</p>
              </div>
            </div>
            
            <div class="bg-amber-50 border border-amber-200 rounded-lg p-6">
              <p class="text-gray-700">
                <span class="font-semibold">Relocation Note:</span> If you are relocating a radiator to a new location, additional planning is needed for rerouting or extending pipework and ensuring secure wall fixings.
              </p>
            </div>
          </div>

          <!-- Pipe Spacing and Connection -->
          <div class="mb-12">
            <h2 class="text-3xl font-bold text-gray-900 mb-6">Pipe Spacing and Connection Constraints</h2>
            
            <p class="text-gray-700 mb-6">
              Not all radiators match existing pipe centres or connection locations. Replacement planning considers:
            </p>
            
            <div class="space-y-4 mb-6">
              <div class="flex items-start">
                <AlertCircle className="w-5 h-5 text-blue-600 mr-3 mt-0.5 flex-shrink-0" />
                <span>Pipe centres (distance between connections)</span>
              </div>
              
              <div class="flex items-start">
                <AlertCircle className="w-5 h-5 text-blue-600 mr-3 mt-0.5 flex-shrink-0" />
                <span>Valve orientation and access</span>
              </div>
              
              <div class="flex items-start">
                <AlertCircle className="w-5 h-5 text-blue-600 mr-3 mt-0.5 flex-shrink-0" />
                <span>Whether a change in radiator size affects alignment</span>
              </div>
            </div>
            
            <div class="grid md:grid-cols-2 gap-6">
              <div class="p-4 bg-gray-50 rounded-lg">
                <p class="text-sm text-gray-700">
                  <span class="font-semibold">Connection Tip:</span> It's important to inspect pipe joints for leaks and use a swivel nut to facilitate easier connection and adjustment during installation.
                </p>
              </div>
              <div class="p-4 bg-blue-50 rounded-lg">
                <p class="text-sm text-gray-700">
                  <span class="font-semibold">Quality Goal:</span> This avoids forced pipework, awkward stress on joints, and poor finishing.
                </p>
              </div>
            </div>
          </div>

          <!-- Image 2: Installation Work -->
          <div class="mb-12">
            <div class="rounded-xl overflow-hidden shadow-lg mb-6">
              <Image 
                src={image3} 
                alt="Professional radiator installation work in progress" 
                width={800}
                height={450}
                class="w-full h-auto"
              />
            </div>
            <p class="text-sm text-gray-500 text-center italic">Professional radiator installation with precision alignment</p>
          </div>

          <!-- Radiator Styles -->
          <div class="mb-12">
            <h2 class="text-3xl font-bold text-gray-900 mb-6">Radiator Styles and Practical Differences</h2>
            
            <div class="space-y-8">
              <div class="bg-gray-50 p-6 rounded-lg">
                <h3 class="text-xl font-bold text-gray-900 mb-4">Standard Panel Radiators</h3>
                <p class="text-gray-700">
                  A common replacement choice where reliability and straightforward fitting are priorities.
                </p>
              </div>
              
              <div class="bg-blue-50 p-6 rounded-lg">
                <h3 class="text-xl font-bold text-gray-900 mb-4">Column-style Radiators</h3>
                <p class="text-gray-700 mb-4">
                  Chosen for certain room aesthetics, but requires careful consideration of:
                </p>
                <div class="grid md:grid-cols-3 gap-4">
                  <div class="p-3 bg-white rounded-lg">
                    <p class="text-sm font-semibold text-gray-900">Wall strength and fixing points</p>
                  </div>
                  <div class="p-3 bg-white rounded-lg">
                    <p class="text-sm font-semibold text-gray-900">Depth and clearance</p>
                  </div>
                  <div class="p-3 bg-white rounded-lg">
                    <p class="text-sm font-semibold text-gray-900">Connection alignment</p>
                  </div>
                </div>
                <div class="mt-4 p-4 bg-blue-100 rounded-lg">
                  <p class="text-sm text-gray-700">
                    <span class="font-semibold">Practical Choice:</span> Some column radiators also offer a cost-effective balance between style and performance, making them a practical choice for many homes.
                  </p>
                </div>
              </div>
              
              <div class="bg-green-50 p-6 rounded-lg">
                <h3 class="text-xl font-bold text-gray-900 mb-4">Vertical Radiators</h3>
                <p class="text-gray-700 mb-4">
                  Useful when wall width is limited, but replacement planning must account for:
                </p>
                <div class="grid md:grid-cols-3 gap-4">
                  <div class="p-3 bg-white rounded-lg">
                    <p class="text-sm font-semibold text-gray-900">Height constraints</p>
                  </div>
                  <div class="p-3 bg-white rounded-lg">
                    <p class="text-sm font-semibold text-gray-900">Pipe entry points</p>
                  </div>
                  <div class="p-3 bg-white rounded-lg">
                    <p class="text-sm font-semibold text-gray-900">Practical valve placement</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Valve Considerations -->
          <div class="mb-12">
            <h2 class="text-3xl font-bold text-gray-900 mb-6">Radiator Valve Considerations During Replacement</h2>
            
            <p class="text-gray-700 mb-6">
              Valves affect usability and control. During replacement, {serviceData.businessName} checks whether the existing valve setup is appropriate for the new radiator.
            </p>
            
            <div class="bg-amber-50 p-6 rounded-lg">
              <h3 class="font-bold text-gray-900 mb-4">Key Considerations Include:</h3>
              <div class="space-y-3">
                <div class="flex items-start">
                  <CheckCircle className="w-5 h-5 text-amber-600 mr-3 mt-0.5 flex-shrink-0" />
                  <span>Valve condition and reliability</span>
                </div>
                <div class="flex items-start">
                  <CheckCircle className="w-5 h-5 text-amber-600 mr-3 mt-0.5 flex-shrink-0" />
                  <span>Ease of access after the new radiator is fitted</span>
                </div>
                <div class="flex items-start">
                  <CheckCircle className="w-5 h-5 text-amber-600 mr-3 mt-0.5 flex-shrink-0" />
                  <span>Sensible positioning for day-to-day adjustment</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Replacement Process -->
          <div class="mb-12">
            <h2 class="text-3xl font-bold text-gray-900 mb-8">Radiator Replacement Process Step by Step</h2>
            
            <div class="space-y-8">
              <div class="flex items-start">
                <div class="flex-shrink-0 w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mr-6">
                  <span class="text-blue-600 font-bold text-xl">1</span>
                </div>
                <div>
                  <h3 class="text-xl font-bold text-gray-900 mb-2">Assessment and Compatibility Checks</h3>
                  <p class="text-gray-700">
                    The existing radiator, pipe spacing, and wall conditions are checked. The room requirements are reviewed so the new radiator choice is practical and suitable.
                  </p>
                </div>
              </div>
              
              <div class="flex items-start">
                <div class="flex-shrink-0 w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mr-6">
                  <span class="text-blue-600 font-bold text-xl">2</span>
                </div>
                <div>
                  <h3 class="text-xl font-bold text-gray-900 mb-2">Clear Explanation Before Work Begins</h3>
                  <p class="text-gray-700">
                    You'll get a clear description of what will be replaced, what needs adjusting, and how the replacement will be completed — with no unclear steps.
                  </p>
                </div>
              </div>
              
              <div class="flex items-start">
                <div class="flex-shrink-0 w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mr-6">
                  <span class="text-blue-600 font-bold text-xl">3</span>
                </div>
                <div>
                  <h3 class="text-xl font-bold text-gray-900 mb-2">Safe Removal of the Existing Radiator</h3>
                  <p class="text-gray-700">
                    The radiator is isolated and removed carefully to prevent mess and avoid strain on existing connections. It is essential to drain all the water from the radiator before removal to prevent leaks and spills. Protect the floor with towels, trays, or buckets to catch any water that may escape during the process.
                  </p>
                </div>
              </div>
              
              <div class="flex items-start">
                <div class="flex-shrink-0 w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mr-6">
                  <span class="text-blue-600 font-bold text-xl">4</span>
                </div>
                <div>
                  <h3 class="text-xl font-bold text-gray-900 mb-2">Installing the New Radiator Securely</h3>
                  <p class="text-gray-700">
                    The new radiator is mounted level and fixed correctly, with secure brackets and stable positioning. It is important to use suitable wall plugs to ensure the radiator brackets are firmly secured to the wall, preventing movement or loosening over time.
                  </p>
                </div>
              </div>
              
              <div class="flex items-start">
                <div class="flex-shrink-0 w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mr-6">
                  <span class="text-blue-600 font-bold text-xl">5</span>
                </div>
                <div>
                  <h3 class="text-xl font-bold text-gray-900 mb-2">Reconnection and Operational Checks</h3>
                  <p class="text-gray-700">
                    Connections are completed correctly, then the radiator is checked for:
                  </p>
                  <div class="mt-2 grid md:grid-cols-2 gap-2 text-sm text-gray-600">
                    <div class="flex items-start">
                      <CheckCircle className="w-3 h-3 text-green-500 mr-2 mt-0.5 flex-shrink-0" />
                      <span>Secure fitting and alignment. Use PTFE tape on threaded joints and tighten fittings properly to prevent leaks at connections.</span>
                    </div>
                    <div class="flex items-start">
                      <CheckCircle className="w-3 h-3 text-green-500 mr-2 mt-0.5 flex-shrink-0" />
                      <span>Stable operation once refilled. Check the pressure gauge to ensure the system is at the correct pressure after refilling.</span>
                    </div>
                    <div class="flex items-start">
                      <CheckCircle className="w-3 h-3 text-green-500 mr-2 mt-0.5 flex-shrink-0" />
                      <span>No seepage at joints and valves. Open the bleed valve to release trapped air and avoid leaks caused by air pockets.</span>
                    </div>
                    <div class="flex items-start">
                      <CheckCircle className="w-3 h-3 text-green-500 mr-2 mt-0.5 flex-shrink-0" />
                      <span>Use a dry cloth to check for small drips at joints and valves, ensuring all connections are watertight.</span>
                    </div>
                  </div>
                  <div class="mt-4 p-4 bg-green-50 rounded-lg">
                    <p class="text-sm text-gray-700">
                      <span class="font-semibold">Essential Steps:</span> Following these steps is essential to avoid leaks and ensure a reliable radiator installation.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Cost Information -->
          <div class="mb-12">
            <h2 class="text-3xl font-bold text-gray-900 mb-6">Radiator Replacement Cost in {serviceData.location}</h2>
            
            <p class="text-gray-700 mb-6">
              The cost of radiator replacement in {serviceData.location} depends on several key factors, including the type and size of the new radiator, the complexity of the installation, and any adjustments needed to your existing pipework or heating system.
            </p>
            
            <div class="bg-amber-50 border-l-4 border-amber-500 p-6 rounded-r-lg mb-6">
              <p class="text-gray-700">
