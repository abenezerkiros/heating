---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { Phone, Shield, CheckCircle, Wrench, Flame, Clock, AlertCircle, DollarSign, MessageCircle, Calendar, Zap, Droplets, Thermometer } from 'lucide-react';
import image1 from "../assets/image/Boiler-Swap-Upgrade.png"
import image2 from "../assets/image/Heating-System-Installation.png"
import image3 from "../assets/image/heaterHero.webp"

// Dynamic data
const serviceData = {
  title: "Boiler Repairs",
  location: "Your Location",
  businessName: "Your Business Name",
  metaDescription: "Professional boiler repairs in [location]. Gas Safe registered engineers for emergency and scheduled boiler repairs.",
  phoneNumber: "YOUR-PHONE-NUMBER"
};
---

<Layout title={`Boiler Repairs in ${serviceData.location} | ${serviceData.businessName}`} description={serviceData.metaDescription}>
  <!-- Hero Section -->
  <section class="relative py-16 md:py-24 bg-gradient-to-r from-blue-900 to-gray-900 text-white overflow-hidden">
    <div class="absolute inset-0 z-0 opacity-20">
    </div>
    
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <div class="mb-4">
            <span class="inline-flex items-center px-4 py-2 rounded-full bg-white/10 backdrop-blur-sm text-white text-sm font-medium border border-white/20">
              <Shield className="w-4 h-4 mr-2" />
              Gas Safe Registered
            </span>
          </div>
          
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">
            Boiler Repairs in <span class="text-orange-400">{serviceData.location}</span>
          </h1>
          
          <p class="text-xl text-gray-300 mb-8 max-w-2xl">
            Emergency and scheduled boiler repairs by Gas Safe registered engineers. Restore your heating and hot water today.
          </p>
          
          <div class="flex flex-wrap gap-4">
            <a href={`tel:${serviceData.phoneNumber}`} class="inline-flex items-center px-8 py-4 bg-orange-500 hover:bg-orange-600 text-white font-semibold rounded-lg transition-all duration-300 shadow-lg hover:shadow-xl">
              <Phone className="w-5 h-5 mr-3" />
              Emergency Call: {serviceData.phoneNumber}
            </a>
            <a href="/contact" class="inline-flex items-center px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-semibold rounded-lg transition-all duration-300 backdrop-blur-sm border border-white/20">
              Book Repair Online
            </a>
          </div>
          
          <div class="mt-8 grid grid-cols-2 md:grid-cols-3 gap-4">
            <div class="flex items-center">
              <CheckCircle className="w-5 h-5 text-green-400 mr-2" />
              <span class="text-sm">24/7 Emergency</span>
            </div>
            <div class="flex items-center">
              <CheckCircle className="w-5 h-5 text-green-400 mr-2" />
              <span class="text-sm">Gas Safe Registered</span>
            </div>
            <div class="flex items-center">
              <CheckCircle className="w-5 h-5 text-green-400 mr-2" />
              <span class="text-sm">Same Day Service</span>
            </div>
          </div>
        </div>
        
        <div class="relative">
          <div class="relative rounded-xl overflow-hidden shadow-2xl transform hover:scale-[1.02] transition-transform duration-300">
            <Image 
              src={image1} 
              alt="Boiler repair technician at work" 
              width={600}
              height={400}
              class="w-full h-auto"
              loading="eager"
              decoding="async"
            />
          </div>
          <div class="absolute -bottom-4 -left-4 bg-white text-gray-900 p-4 rounded-lg shadow-lg max-w-xs">
            <div class="flex items-center mb-2">
              <Flame className="w-5 h-5 text-blue-500 mr-2" />
              <span class="font-semibold">All Customers Welcome</span>
            </div>
            <p class="text-sm">No need to be a British Gas customer</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-12">
        <!-- Main Content Column -->
        <div class="lg:col-span-2">
          <!-- Introduction -->
          <div class="prose prose-lg max-w-none mb-12">
            <p class="lead text-xl text-gray-700 mb-8">
              If you're searching for boiler repairs in {serviceData.location}, you want your heating and hot water working properly again — without guesswork.
            </p>
            
            <p>
              Whether it's no heating, no hot water, low pressure, repeated shutdowns, strange noises, or a boiler that keeps locking out, {serviceData.businessName} starts with diagnosis, explains the fault clearly, and only repairs once the cause is confirmed.
            </p>
            
            <div class="bg-blue-50 border-l-4 border-blue-500 p-6 my-6 rounded-r-lg">
              <p class="font-semibold text-blue-800">
                The outcome is stable operation you can rely on, with the issue resolved at the source rather than temporarily masked.
              </p>
            </div>
            
            <p>
              You do not need to be a British Gas customer or an existing customer to book a repair—our company welcomes all customers. Booking a repair is straightforward and can be done online or by phone.
            </p>
            
            <p class="font-semibold text-blue-700">
              Book a boiler repair in {serviceData.location} with {serviceData.businessName}. Our company provides services for both domestic and commercial customers, ensuring tailored support for every need. All repairs are performed by Gas Safe registered engineers to ensure safety and reliability.
            </p>
          </div>

          <!-- Diagnosis Focus -->
          <div class="mb-12">
            <h2 class="text-3xl font-bold text-gray-900 mb-6">Boiler Repairs in {serviceData.location} That Start With Diagnosis</h2>
            
            <p class="text-gray-700 mb-6">
              Boiler repair only works when the fault is identified properly. Many boiler problems share the same symptoms, so replacing parts based on assumptions often leads to repeat breakdowns.
            </p>
            
            <div class="grid md:grid-cols-3 gap-6 mb-8">
              <div class="bg-blue-50 p-6 rounded-lg text-center">
                <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
                  <CheckCircle className="w-6 h-6 text-blue-600" />
                </div>
                <h3 class="font-bold text-gray-900 mb-2">Finding the Fault</h3>
                <p class="text-sm text-gray-700">Before taking action</p>
              </div>
              
              <div class="bg-green-50 p-6 rounded-lg text-center">
                <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
                  <MessageCircle className="w-6 h-6 text-green-600" />
                </div>
                <h3 class="font-bold text-gray-900 mb-2">Clear Explanation</h3>
                <p class="text-sm text-gray-700">What failed and needs fixing</p>
              </div>
              
              <div class="bg-orange-50 p-6 rounded-lg text-center">
                <div class="w-12 h-12 bg-orange-100 rounded-full flex items-center justify-center mx-auto mb-4">
                  <Flame className="w-6 h-6 text-orange-600" />
                </div>
                <h3 class="font-bold text-gray-900 mb-2">Restore Function</h3>
                <p class="text-sm text-gray-700">Safe, consistent heating & hot water</p>
              </div>
            </div>
            
            <div class="p-6 bg-gray-50 rounded-lg border-l-4 border-gray-500">
              <p class="text-gray-700">
                <span class="font-semibold">Spare Parts Available:</span> Our experienced gas engineers carry a range of spare parts, allowing many boiler faults to be fixed immediately if the necessary parts are available.
              </p>
            </div>
          </div>

          <!-- Emergency Repairs -->
          <div class="mb-12">
            <h2 class="text-3xl font-bold text-gray-900 mb-6">Emergency Gas Boiler Repairs</h2>
            
            <p class="text-gray-700 mb-6">
              When your boiler breaks down unexpectedly, you need a fast and reliable solution to restore your heating system and hot water.
            </p>
            
            <div class="bg-red-50 border-l-4 border-red-500 p-6 rounded-r-lg mb-6">
              <p class="text-gray-700">
                <span class="font-semibold">24/7 Service:</span> That's why we offer emergency gas boiler repairs 24/7, so you're never left in the cold. Our emergency boiler repair service is delivered by a nationwide network of Gas Safe engineers, ensuring a qualified local engineer is always available when you need them most.
              </p>
            </div>
            
            <div class="space-y-4 mb-6">
              <div class="flex items-start">
                <CheckCircle className="w-5 h-5 text-green-500 mr-3 mt-0.5 flex-shrink-0" />
                <span>Whether you have an existing British Gas cover or not, our team can quickly diagnose and fix any issue with your gas boiler.</span>
              </div>
              
              <div class="flex items-start">
                <CheckCircle className="w-5 h-5 text-green-500 mr-3 mt-0.5 flex-shrink-0" />
                <span>We understand how disruptive a broken boiler can be, so our aim is to get your boiler working again as soon as possible.</span>
              </div>
              
              <div class="flex items-start">
                <CheckCircle className="w-5 h-5 text-green-500 mr-3 mt-0.5 flex-shrink-0" />
                <span>From minor faults to major breakdowns, we provide a complete repair service to keep your heating and hot water running smoothly.</span>
              </div>
            </div>
            
            <div class="p-6 bg-blue-50 rounded-lg">
              <p class="text-gray-700">
                <span class="font-semibold">Easy Booking:</span> Book online or call for immediate assistance and relax knowing your boiler is in safe hands.
              </p>
            </div>
          </div>

          <!-- Image 1: Diagnostic Process -->
          <div class="mb-12">
            <div class="rounded-xl overflow-hidden shadow-lg mb-6">
              <Image 
                src={image2} 
                alt="Boiler diagnostic testing and repair process" 
                width={800}
                height={450}
                class="w-full h-auto"
              />
            </div>
            <p class="text-sm text-gray-500 text-center italic">Comprehensive boiler diagnostic testing</p>
          </div>

          <!-- What Repair Includes -->
          <div class="mb-12">
            <h2 class="text-3xl font-bold text-gray-900 mb-6">What Boiler Repair Includes</h2>
            
            <p class="text-gray-700 mb-6">
              A boiler repair visit is built around fault isolation and targeted correction. Depending on the issue, boiler repair can include:
            </p>
            
            <div class="grid md:grid-cols-2 gap-6 mb-8">
              <div class="space-y-4">
                <div class="flex items-start">
                  <CheckCircle className="w-5 h-5 text-green-500 mr-3 mt-0.5 flex-shrink-0" />
                  <span>Investigating the reported symptom and operating conditions</span>
                </div>
                <div class="flex items-start">
                  <CheckCircle className="w-5 h-5 text-green-500 mr-3 mt-0.5 flex-shrink-0" />
                  <span>Checking boiler status, fault history, and shutdown behaviour</span>
                </div>
                <div class="flex items-start">
                  <CheckCircle className="w-5 h-5 text-green-500 mr-3 mt-0.5 flex-shrink-0" />
                  <span>Testing key controls and safety responses</span>
                </div>
              </div>
              
              <div class="space-y-4">
                <div class="flex items-start">
                  <CheckCircle className="w-5 h-5 text-green-500 mr-3 mt-0.5 flex-shrink-0" />
                  <span>Repairing the specific failed component or connection causing the fault</span>
                </div>
                <div class="flex items-start">
                  <CheckCircle className="w-5 h-5 text-green-500 mr-3 mt-0.5 flex-shrink-0" />
                  <span>Verifying stable operation after the repair</span>
                </div>
              </div>
            </div>
            
            <div class="grid md:grid-cols-2 gap-6">
              <div class="p-6 bg-green-50 rounded-lg">
                <h3 class="font-bold text-gray-900 mb-3">Guarantee & Report</h3>
                <p class="text-gray-700">
                  All boiler repairs include parts and labour, come with a 12-month guarantee, and homeowners receive a report detailing the work completed, faults found, and safety test results.
                </p>
              </div>
            </div>
          </div>

          <!-- Fault-First Repair -->
          <div class="mb-12">
            <h2 class="text-3xl font-bold text-gray-900 mb-6">Fault-First Boiler Repair: How the Diagnosis is Done</h2>
            
            <p class="text-gray-700 mb-6">
              Repair begins by separating what you're experiencing (symptoms) from what's actually failing (cause). Diagnosis may involve:
            </p>
            
            <div class="grid md:grid-cols-2 gap-6">
              <div class="space-y-4">
                <div class="flex items-start">
                  <CheckCircle className="w-5 h-5 text-blue-500 mr-3 mt-0.5 flex-shrink-0" />
                  <span>Checking whether the fault is constant or intermittent</span>
                </div>
                <div class="flex items-start">
                  <CheckCircle className="w-5 h-5 text-blue-500 mr-3 mt-0.5 flex-shrink-0" />
                  <span>Testing the boiler under demand (heating, hot water, and combined load)</span>
                </div>
              </div>
              
              <div class="space-y-4">
                <div class="flex items-start">
                  <CheckCircle className="w-5 h-5 text-blue-500 mr-3 mt-0.5 flex-shrink-0" />
                  <span>Confirming whether the boiler is failing to start, failing to stay running, or stopping for protection</span>
                </div>
                <div class="flex items-start">
                  <CheckCircle className="w-5 h-5 text-blue-500 mr-3 mt-0.5 flex-shrink-0" />
                  <span>Identifying whether the issue is driven by pressure, flow, ignition, sensors, or control logic</span>
                </div>
              </div>
            </div>
            
            <div class="mt-6 p-6 bg-blue-50 rounded-lg">
              <p class="text-gray-700">
                <span class="font-semibold">Precise Repair:</span> This prevents "chasing symptoms" and keeps the repair precise.
              </p>
            </div>
          </div>

          <!-- Common Repair Types -->
          <div class="mb-12">
            <h2 class="text-3xl font-bold text-gray-900 mb-6">Common Boiler Repair Scenarios</h2>
            
            <div class="space-y-8">
              <!-- No Heating -->
              <div class="bg-red-50 p-6 rounded-lg">
                <h3 class="text-xl font-bold text-gray-900 mb-4">No Heating Boiler Repairs</h3>
                <p class="text-gray-700 mb-4">
                  "No heating" can mean several different failure states. Boiler repair for no heating focuses on what the boiler is doing when heating is requested.
                </p>
                
                <div class="grid md:grid-cols-2 gap-6">
                  <div>
                    <h4 class="font-bold text-gray-900 mb-3">Common Scenarios:</h4>
                    <ul class="space-y-2 text-sm text-gray-700">
                      <li class="flex items-start">
                        <AlertCircle className="w-4 h-4 text-red-500 mr-2 mt-0.5 flex-shrink-0" />
                        <span>Boiler powers on but radiators stay cold</span>
                      </li>
                      <li class="flex items-start">
                        <AlertCircle className="w-4 h-4 text-red-500 mr-2 mt-0.5 flex-shrink-0" />
                        <span>Heating runs briefly then stops</span>
                      </li>
                      <li class="flex items-start">
                        <AlertCircle className="w-4 h-4 text-red-500 mr-2 mt-0.5 flex-shrink-0" />
                        <span>Boiler appears to run but heat doesn't circulate</span>
                      </li>
                      <li class="flex items-start">
                        <AlertCircle className="w-4 h-4 text-red-500 mr-2 mt-0.5 flex-shrink-0" />
                        <span>Heating works intermittently</span>
                      </li>
                    </ul>
                  </div>
                  
                  <div>
                    <h4 class="font-bold text-gray-900 mb-3">Repair Focus:</h4>
                    <ul class="space-y-2 text-sm text-gray-700">
                      <li class="flex items-start">
                        <CheckCircle className="w-4 h-4 text-green-500 mr-2 mt-0.5 flex-shrink-0" />
                        <span>Whether the boiler is firing correctly</span>
                      </li>
                      <li class="flex items-start">
                        <CheckCircle className="w-4 h-4 text-green-500 mr-2 mt-0.5 flex-shrink-0" />
                        <span>Whether heat is being produced but not moving</span>
                      </li>
                      <li class="flex items-start">
                        <CheckCircle className="w-4 h-4 text-green-500 mr-2 mt-0.5 flex-shrink-0" />
                        <span>Whether the boiler is shutting down due to protection</span>
                      </li>
                    </ul>
                  </div>
                </div>
              </div>
              
              <!-- No Hot Water -->
              <div class="bg-blue-50 p-6 rounded-lg">
                <h3 class="text-xl font-bold text-gray-900 mb-4">No Hot Water Boiler Repairs</h3>
                <p class="text-gray-700 mb-4">
                  "No hot water" can be caused by different faults than "no heating," so it must be diagnosed on its own.
                </p>
                
                <div class="grid md:grid-cols-2 gap-6">
                  <div>
                    <h4 class="font-bold text-gray-900 mb-3">Common Scenarios:</h4>
                    <ul class="space-y-2 text-sm text-gray-700">
                      <li class="flex items-start">
                        <AlertCircle className="w-4 h-4 text-blue-500 mr-2 mt-0.5 flex-shrink-0" />
                        <span>Hot water turns cold during use</span>
                      </li>
                      <li class="flex items-start">
                        <AlertCircle className="w-4 h-4 text-blue-500 mr-2 mt-0.5 flex-shrink-0" />
                        <span>Hot water is intermittent</span>
                      </li>
                      <li class="flex items-start">
                        <AlertCircle className="w-4 h-4 text-blue-500 mr-2 mt-0.5 flex-shrink-0" />
                        <span>Hot water only works at low flow</span>
                      </li>
                      <li class="flex items-start">
                        <AlertCircle className="w-4 h-4 text-blue-500 mr-2 mt-0.5 flex-shrink-0" />
                        <span>Long delays before hot water arrives</span>
                      </li>
                    </ul>
                  </div>
                  
                  <div>
                    <h4 class="font-bold text-gray-900 mb-3">Diagnosis Priority:</h4>
                    <ul class="space-y-2 text-sm text-gray-700">
                      <li class="flex items-start">
                        <CheckCircle className="w-4 h-4 text-green-500 mr-2 mt-0.5 flex-shrink-0" />
                        <span>Whether the boiler responds correctly to hot water demand</span>
                      </li>
                      <li class="flex items-start">
                        <CheckCircle className="w-4 h-4 text-green-500 mr-2 mt-0.5 flex-shrink-0" />
                        <span>Whether the boiler can maintain output under steady use</span>
                      </li>
                      <li class="flex items-start">
                        <CheckCircle className="w-4 h-4 text-green-500 mr-2 mt-0.5 flex-shrink-0" />
                        <span>Whether the issue appears only under higher demand</span>
                      </li>
                    </ul>
                  </div>
                </div>
              </div>
              
              <!-- Pressure Problems -->
              <div class="bg-green-50 p-6 rounded-lg">
                <h3 class="text-xl font-bold text-gray-900 mb-4">Boiler Pressure Problems</h3>
                <p class="text-gray-700 mb-4">
                  Pressure issues are often a symptom, not the fault itself. A proper repair focuses on why pressure is changing, not just topping it up.
                </p>
                
                <div class="grid md:grid-cols-2 gap-6">
                  <div>
                    <h4 class="font-bold text-gray-900 mb-3">Common Issues:</h4>
                    <ul class="space-y-2 text-sm text-gray-700">
                      <li class="flex items-start">
                        <AlertCircle className="w-4 h-4 text-green-500 mr-2 mt-0.5 flex-shrink-0" />
                        <span>Pressure drops repeatedly after refilling</span>
                      </li>
                      <li class="flex items-start">
                        <AlertCircle className="w-4 h-4 text-green-500 mr-2 mt-0.5 flex-shrink-0" />
                        <span>Boiler locks out due to low pressure</span>
                      </li>
                      <li class="flex items-start">
                        <AlertCircle className="w-4 h-4 text-green-500 mr-2 mt-0.5 flex-shrink-0" />
                        <span>Pressure rises unexpectedly during operation</span>
                      </li>
                      <li class="flex items-start">
                        <AlertCircle className="w-4 h-4 text-green-500 mr-2 mt-0.5 flex-shrink-0" />
                        <span>Pressure fluctuates between uses</span>
                      </li>
                    </ul>
                  </div>
                  
                  <div>
                    <h4 class="font-bold text-gray-900 mb-3">Repair Focus:</h4>
                    <ul class="space-y-2 text-sm text-gray-700">
                      <li class="flex items-start">
                        <CheckCircle className="w-4 h-4 text-blue-500 mr-2 mt-0.5 flex-shrink-0" />
                        <span>Identifying why pressure won't remain stable</span>
                      </li>
                      <li class="flex items-start">
                        <CheckCircle className="w-4 h-4 text-blue-500 mr-2 mt-0.5 flex-shrink-0" />
                        <span>Correcting the underlying cause</span>
                      </li>
                      <li class="flex items-start">
                        <CheckCircle className="w-4 h-4 text-blue-500 mr-2 mt-0.5 flex-shrink-0" />
                        <span>Preventing repeat issues</span>
                      </li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Image 2: Repair Work -->
          <div class="mb-12">
            <div class="rounded-xl overflow-hidden shadow-lg mb-6">
              <Image 
                src={image3} 
                alt="Professional boiler repair work in progress" 
                width={800}
                height={450}
                class="w-full h-auto"
              />
            </div>
            <p class="text-sm text-gray-500 text-center italic">Expert boiler repair and component replacement</p>
          </div>

          <!-- More Repair Scenarios -->
          <div class="mb-12">
            <div class="space-y-8">
              <!-- Switching Off -->
              <div class="bg-orange-50 p-6 rounded-lg">
                <h3 class="text-xl font-bold text-gray-900 mb-4">Boiler Keeps Switching Off or Cutting Out</h3>
                <p class="text-gray-700 mb-4">
                  A boiler that keeps turning itself off is usually reacting to instability, incorrect readings, or protective shutdown behaviour.
                </p>
                
                <div class="grid md:grid-cols-2 gap-6">
                  <div>
                    <h4 class="font-bold text-gray-900 mb-3">Common Patterns:</h4>
                    <ul class="space-y-2 text-sm text-gray-700">
                      <li class="flex items-start">
                        <AlertCircle className="w-4 h-4 text-orange-500 mr-2 mt-0.5 flex-shrink-0" />
                        <span>Runs briefly then stops (short cycling)</span>
                      </li>
                      <li class="flex items-start">
                        <AlertCircle className="w-4 h-4 text-orange-500 mr-2 mt-0.5 flex-shrink-0" />
                        <span>Stops randomly during heating</span>
                      </li>
                      <li class="flex items-start">
                        <AlertCircle className="w-4 h-4 text-orange-500 mr-2 mt-0.5 flex-shrink-0" />
                        <span>Stops when hot water is used</span>
                      </li>
                      <li class="flex items-start">
                        <AlertCircle className="w-4 h-4 text-orange-500 mr-2 mt-0.5 flex-shrink-0" />
                        <span>Stops when both heating and hot water are demanded</span>
                      </li>
                    </ul>
                  </div>
                  
                  <div>
                    <h4 class="font-bold text-gray-900 mb-3">Repair Focus:</h4>
                    <ul class="space-y-2 text-sm text-gray-700">
                      <li class="flex items-start">
                        <CheckCircle className="w-4 h-4 text-green-500 mr-2 mt-0.5 flex-shrink-0" />
                        <span>Reproducing the cut-out condition</span>
                      </li>
                      <li class="flex items-start">
                        <CheckCircle className="w-4 h-4 text-green-500 mr-2 mt-0.5 flex-shrink-0" />
                        <span>Identifying the trigger for shutdown</span>
                      </li>
                      <li class="flex items-start">
                        <CheckCircle className="w-4 h-4 text-green-500 mr-2 mt-0.5 flex-shrink-0" />
                        <span>Fixing the cause for consistent operation</span>
                      </li>
                    </ul>
                  </div>
                </div>
              </div>
              
              <!-- Lockout Issues -->
              <div class="bg-purple-50 p-6 rounded-lg">
                <h3 class="text-xl font-bold text-gray-900 mb-4">Boiler Locking Out and Error States</h3>
                <p class="text-gray-700 mb-4">
                  Lockouts are the boiler refusing to run until the issue is addressed. Resetting may restore operation briefly, but the fault often returns.
                </p>
                
                <div class="grid md:grid-cols-2 gap-6">
                  <div>
                    <h4 class="font-bold text-gray-900 mb-3">Common Situations:</h4>
                    <ul class="space-y-2 text-sm text-gray-700">
                      <li class="flex items-start">
                        <AlertCircle className="w-4 h-4 text-purple-500 mr-2 mt-0.5 flex-shrink-0" />
                        <span>Lockout occurs repeatedly within a short time</span>
                      </li>
