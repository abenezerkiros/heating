---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { Phone, Shield, CheckCircle, Wrench, Flame, Clock, AlertCircle, DollarSign, MessageCircle, Calendar, Zap, Droplets, Thermometer } from 'lucide-react';
import image1 from "../assets/image/Boiler-Swap-Upgrade.png"
import image2 from "../assets/image/Heating-System-Installation.png"
import image3 from "../assets/image/heaterHero.webp"

// Dynamic data
const serviceData = {
  title: "Boiler Installation",
  location: "Your Location",
  businessName: "Your Business Name",
  metaDescription: "Professional boiler installations in [location]. Gas Safe registered engineers for new boiler fitting and upgrades.",
  phoneNumber: "YOUR-PHONE-NUMBER"
};
---

<Layout title={`Boiler Installation in ${serviceData.location} | ${serviceData.businessName}`} description={serviceData.metaDescription}>
  <!-- Hero Section -->
  <section class="relative py-16 md:py-24 bg-gradient-to-r from-blue-900 to-gray-900 text-white overflow-hidden">
    <div class="absolute inset-0 z-0 opacity-20">
    </div>
    
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <div class="mb-4">
            <span class="inline-flex items-center px-4 py-2 rounded-full bg-white/10 backdrop-blur-sm text-white text-sm font-medium border border-white/20">
              <Shield className="w-4 h-4 mr-2" />
              Gas Safe Registered
            </span>
          </div>
          
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">
            Boiler Installation in <span class="text-orange-400">{serviceData.location}</span>
          </h1>
          
          <p class="text-xl text-gray-300 mb-8 max-w-2xl">
            Professional new boiler fitting and upgrades by Gas Safe registered engineers. Improve your home's comfort and efficiency today.
          </p>
          
          <div class="flex flex-wrap gap-4">
            <a href={`tel:${serviceData.phoneNumber}`} class="inline-flex items-center px-8 py-4 bg-orange-500 hover:bg-orange-600 text-white font-semibold rounded-lg transition-all duration-300 shadow-lg hover:shadow-xl">
              <Phone className="w-5 h-5 mr-3" />
              Call Now: {serviceData.phoneNumber}
            </a>
            <a href="/contact" class="inline-flex items-center px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-semibold rounded-lg transition-all duration-300 backdrop-blur-sm border border-white/20">
              Book Installation Online
            </a>
          </div>
          
          <div class="mt-8 grid grid-cols-2 md:grid-cols-3 gap-4">
            <div class="flex items-center">
              <CheckCircle className="w-5 h-5 text-green-400 mr-2" />
              <span class="text-sm">Fixed Price Quotes</span>
            </div>
            <div class="flex items-center">
              <CheckCircle className="w-5 h-5 text-green-400 mr-2" />
              <span class="text-sm">Gas Safe Registered</span>
            </div>
            <div class="flex items-center">
              <CheckCircle className="w-5 h-5 text-green-400 mr-2" />
              <span class="text-sm">Eco-Friendly Options</span>
            </div>
          </div>
        </div>
        
        <div class="relative">
          <div class="relative rounded-xl overflow-hidden shadow-2xl transform hover:scale-[1.02] transition-transform duration-300">
            <Image 
              src={image1} 
              alt="Boiler installation technician at work" 
              width={600}
              height={400}
              class="w-full h-auto"
              loading="eager"
              decoding="async"
            />
          </div>
          <div class="absolute -bottom-4 -left-4 bg-white text-gray-900 p-4 rounded-lg shadow-lg max-w-xs">
            <div class="flex items-center mb-2">
              <Flame className="w-5 h-5 text-blue-500 mr-2" />
              <span class="font-semibold">All Customers Welcome</span>
            </div>
            <p class="text-sm">Professional installation for any property</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-12">
        <!-- Main Content Column -->
        <div class="lg:col-span-2">
          <!-- Introduction -->
          <div class="prose prose-lg max-w-none mb-12">
            <p class="lead text-xl text-gray-700 mb-8">
              If you’re searching for boiler installations in {serviceData.location}, you’re likely dealing with an old, unreliable boiler or an old boiler that needs to be replaced, frequent breakdowns, uneven heating, rising energy bills, or a system that no longer meets your household’s needs. Choosing to replace your boiler is a convenient and cost-effective way to improve your home’s comfort and efficiency. {serviceData.businessName} handles boiler installations by first assessing your property and usage requirements, clearly explaining your options, and confirming the right solution before any work begins. The result is a correctly sized, safely installed boiler that delivers reliable heating and hot water from day one. You can also choose to glow green with our eco-friendly, energy-efficient boiler options designed to reduce your carbon footprint.
            </p>
            
            <div class="bg-blue-50 border-l-4 border-blue-500 p-6 my-6 rounded-r-lg">
              <p class="font-semibold text-blue-800">
                Book your boiler installation in {serviceData.location} today with {serviceData.businessName}.
              </p>
            </div>
            
            <h2 class="text-3xl font-bold text-gray-900 mb-6">
              Boiler installation services in {serviceData.location}
            </h2>

            <p>
              Boiler installation is not just about fitting a new unit — it is about ensuring the entire heating setup works efficiently, safely, and reliably for your home. {serviceData.businessName} provides a complete boiler installation service in {serviceData.location}, focused solely on installing new boilers that are suitable for your property and daily usage, with the expertise to install boilers from leading manufacturers.
            </p>
            
            <p>
              Every installation is approached with careful planning, correct system matching, and attention to long-term performance. All installations are carried out by Gas Safe registered and Gas Safe engineers to ensure safety and compliance. {serviceData.businessName} also works with experienced local installers who are familiar with the area.
            </p>
          </div>

          <!-- What Installation Includes -->
          <div class="mb-12">
            <h2 class="text-3xl font-bold text-gray-900 mb-6">What a boiler installation includes</h2>
            
            <p class="text-gray-700 mb-6">
              A professional boiler installation covers more than replacing an old unit. The service typically includes:
            </p>
            
            <div class="grid md:grid-cols-3 gap-6 mb-8">
              <div class="bg-blue-50 p-6 rounded-lg text-center">
                <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
                  <CheckCircle className="w-6 h-6 text-blue-600" />
                </div>
                <h3 class="font-bold text-gray-900 mb-2">Assessment</h3>
                <p class="text-sm text-gray-700">Assessment of heating and hot water demand, including details about your current boiler</p>
              </div>
              
              <div class="bg-green-50 p-6 rounded-lg text-center">
                <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
                  <Wrench className="w-6 h-6 text-green-600" />
                </div>
                <h3 class="font-bold text-gray-900 mb-2">Selection</h3>
                <p class="text-sm text-gray-700">Selection of the correct boiler size and type</p>
              </div>
              
              <div class="bg-orange-50 p-6 rounded-lg text-center">
                <div class="w-12 h-12 bg-orange-100 rounded-full flex items-center justify-center mx-auto mb-4">
                  <Flame className="w-6 h-6 text-orange-600" />
                </div>
                <h3 class="font-bold text-gray-900 mb-2">Installation</h3>
                <p class="text-sm text-gray-700">Installation of the new boiler and required components</p>
              </div>
            </div>

            <p class="text-gray-700 mb-6">
              Removal and safe disconnection of the current boiler, followed by installation of the replacement boiler
            </p>

            <p class="text-gray-700 mb-6">
              System checks to confirm correct operation
            </p>
            
            <div class="p-6 bg-gray-50 rounded-lg border-l-4 border-gray-500">
              <p class="text-gray-700">
                <span class="font-semibold">Complete Service:</span> A professional boiler replacement also includes the safe disposal of your old unit and the complete installation of the new system. Each step is completed with accuracy to ensure the boiler performs as intended once installed.
              </p>
            </div>
          </div>

          <!-- Choosing the Right Boiler -->
          <div class="mb-12">
            <h2 class="text-3xl font-bold text-gray-900 mb-6">Choosing the right boiler for your property</h2>
            
            <p class="text-gray-700 mb-6">
              Not every boiler is suitable for every home. During a boiler installation, {serviceData.businessName} considers factors such as:
            </p>
            
            <div class="space-y-4 mb-6">
              <div class="flex items-start">
                <CheckCircle className="w-5 h-5 text-green-500 mr-3 mt-0.5 flex-shrink-0" />
                <span>Property size and number of rooms</span>
              </div>
              
              <div class="flex items-start">
                <CheckCircle className="w-5 h-5 text-green-500 mr-3 mt-0.5 flex-shrink-0" />
                <span>Number of bathrooms and hot water demand (homes with multiple bathrooms or more than one bathroom may require a system boiler to ensure consistent hot water supply to all outlets)</span>
              </div>
              
              <div class="flex items-start">
                <CheckCircle className="w-5 h-5 text-green-500 mr-3 mt-0.5 flex-shrink-0" />
                <span>Existing heating system layout</span>
              </div>

              <div class="flex items-start">
                <CheckCircle className="w-5 h-5 text-green-500 mr-3 mt-0.5 flex-shrink-0" />
                <span>Water pressure and usage patterns</span>
              </div>
            </div>
            
            <p class="text-gray-700 mb-6">
              A combi boiler is often suitable for smaller homes with lower hot water demand, offering a space-saving and efficient solution.
            </p>

            <div class="p-6 bg-blue-50 rounded-lg">
              <p class="text-gray-700">
                <span class="font-semibold">Tailored Solution:</span> This ensures the boiler installed in your {serviceData.location} property matches real-world usage, not just manufacturer specifications.
              </p>
            </div>
          </div>

          <!-- Installation Process -->
          <div class="mb-12">
            <h2 class="text-3xl font-bold text-gray-900 mb-6">Boiler installation process step by step</h2>
            
            <p class="text-gray-700 mb-6">
              A clear and structured process helps avoid mistakes and future issues. Every step is carried out by a qualified Gas Safe engineer to ensure compliance and safety. Having an A rated boiler installed can maximize energy efficiency and provide long-term savings.
            </p>
            
            <div class="space-y-8">
              <!-- Step 1 -->
              <div class="bg-white border border-gray-200 rounded-lg p-6">
                <div class="flex items-center mb-4">
                  <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center mr-4">
                    <span class="text-blue-600 font-bold">1</span>
                  </div>
                  <h3 class="text-xl font-bold text-gray-900">Initial assessment</h3>
                </div>
                <p class="text-gray-700">
                  The installation begins with a detailed inspection of your current boiler and property requirements. This determines the correct boiler specification and installation approach.
                </p>
              </div>
              
              <!-- Step 2 -->
              <div class="bg-white border border-gray-200 rounded-lg p-6">
                <div class="flex items-center mb-4">
                  <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center mr-4">
                    <span class="text-green-600 font-bold">2</span>
                  </div>
                  <h3 class="text-xl font-bold text-gray-900">Installation planning</h3>
                </div>
                <p class="text-gray-700">
                  Pipework connections, positioning, ventilation requirements, system compatibility, and the thermal performance of the new system are confirmed before work starts to ensure maximum efficiency.
                </p>
              </div>
              
              <!-- Step 3 -->
              <div class="bg-white border border-gray-200 rounded-lg p-6">
                <div class="flex items-center mb-4">
                  <div class="w-10 h-10 bg-orange-100 rounded-full flex items-center justify-center mr-4">
                    <span class="text-orange-600 font-bold">3</span>
                  </div>
                  <h3 class="text-xl font-bold text-gray-900">Boiler fitting</h3>
                </div>
                <p class="text-gray-700">
                  {serviceData.businessName} installs boilers from leading brands such as Worcester Bosch, following manufacturer guidelines and industry standards to ensure safe operation and efficient performance. If you choose a combi boiler, it is fitted as a single unit, combining both heating and hot water functions in one compact appliance. Customers can also opt for a new gas boiler installation if it best suits their property and preferences.
                </p>
              </div>
              
              <!-- Step 4 -->
              <div class="bg-white border border-gray-200 rounded-lg p-6">
                <div class="flex items-center mb-4">
                  <div class="w-10 h-10 bg-purple-100 rounded-full flex items-center justify-center mr-4">
                    <span class="text-purple-600 font-bold">4</span>
                  </div>
                  <h3 class="text-xl font-bold text-gray-900">System testing and checks</h3>
                </div>
                <p class="text-gray-700">
                  After installation, the system is checked to confirm correct heating output, hot water delivery, and stable operation, including verifying the correct operation of the room thermostat and thermostatic radiator controls for improved energy management.
                </p>
              </div>
            </div>
          </div>

          <!-- Image 1: Installation Process -->
          <div class="mb-12">
            <div class="rounded-xl overflow-hidden shadow-lg mb-6">
              <Image 
                src={image2} 
                alt="Boiler installation process" 
                width={800}
                height={450}
                class="w-full h-auto"
              />
            </div>
            <p class="text-sm text-gray-500 text-center italic">Professional boiler installation and system setup</p>
          </div>

          <!-- Common Situations -->
          <div class="mb-12">
            <h2 class="text-3xl font-bold text-gray-900 mb-6">Common situations that require a new boiler installation</h2>
            
            <p class="text-gray-700 mb-6">
              Boiler installation is often needed when:
            </p>
            
            <div class="space-y-4 mb-6">
              <div class="flex items-start">
                <AlertCircle className="w-5 h-5 text-red-500 mr-3 mt-0.5 flex-shrink-0" />
                <span>An existing boiler is outdated or inefficient, making boiler replacement the best solution</span>
              </div>
              
              <div class="flex items-start">
                <AlertCircle className="w-5 h-5 text-red-500 mr-3 mt-0.5 flex-shrink-0" />
                <span>Heating performance is inconsistent across the property</span>
              </div>
              
              <div class="flex items-start">
                <AlertCircle className="w-5 h-5 text-red-500 mr-3 mt-0.5 flex-shrink-0" />
                <span>Hot water demand exceeds system capacity</span>
              </div>
              
              <div class="flex items-start">
                <AlertCircle className="w-5 h-5 text-red-500 mr-3 mt-0.5 flex-shrink-0" />
                <span>Replacement parts are no longer available</span>
              </div>
              
              <div class="flex items-start">
                <AlertCircle className="w-5 h-5 text-red-500 mr-3 mt-0.5 flex-shrink-0" />
                <span>A property upgrade requires a more suitable boiler</span>
              </div>
            </div>

            <div class="bg-green-50 border-l-4 border-green-500 p-6 rounded-r-lg">
              <p class="text-gray-700">
                <span class="font-semibold">Efficiency Improvement:</span> Choosing to replace your boiler can improve energy efficiency and result in lower energy bills. Installing the correct boiler resolves these issues at the system level rather than relying on temporary fixes.
              </p>
            </div>
          </div>

          <!-- Installation Time -->
          <div class="mb-12">
            <h2 class="text-3xl font-bold text-gray-900 mb-6">How long a boiler installation takes</h2>
            
            <p class="text-gray-700 mb-6">
              Most boiler installations in {serviceData.location} are completed within a standard working timeframe, but installation times can vary depending on the specific requirements of each property, such as:
            </p>
            
            <div class="grid md:grid-cols-2 gap-6 mb-8">
              <div class="space-y-4">
                <div class="flex items-start">
                  <CheckCircle className="w-5 h-5 text-blue-500 mr-3 mt-0.5 flex-shrink-0" />
                  <span>Boiler type and system complexity</span>
                </div>
                <div class="flex items-start">
                  <CheckCircle className="w-5 h-5 text-blue-500 mr-3 mt-0.5 flex-shrink-0" />
                  <span>Existing pipework condition</span>
                </div>
              </div>
              
              <div class="space-y-4">
                <div class="flex items-start">
                  <CheckCircle className="w-5 h-5 text-blue-500 mr-3 mt-0.5 flex-shrink-0" />
                  <span>Accessibility of the installation area</span>
                </div>
              </div>
            </div>
            
            <div class="p-6 bg-blue-50 rounded-lg">
              <p class="text-gray-700">
                <span class="font-semibold">Quality Assurance:</span> {serviceData.businessName} ensures the work is completed efficiently without compromising installation quality.
              </p>
            </div>
          </div>

          <!-- Cost and Pricing -->
          <div class="mb-12">
            <h2 class="text-3xl font-bold text-gray-900 mb-6">Boiler cost and pricing</h2>
            
            <p class="text-gray-700 mb-6">
              Boiler cost and pricing can vary significantly depending on the type of boiler, its size, and the complexity of the installation. When considering a new boiler installation, it's essential to factor in not just the initial cost of the boiler itself, but also the cost of installation, potential savings on energy bills, and the cost of any additional components such as a hot water cylinder or thermostatic radiator valves.
            </p>
            
            <p class="text-gray-700 mb-6">
              The price of a new boiler depends largely on the type of boiler you choose—combi, system, or conventional boilers each come with their own price range and installation requirements. Larger homes or those with higher hot water demand may require a bigger or more advanced boiler, which can increase the initial cost. Additionally, the complexity of the installation—such as upgrading pipework or adding new thermostatic radiator valves—can affect the overall boiler cost.
            </p>
            
            <p class="text-gray-700 mb-6">
              It's also important to consider the long-term benefits of installing a new, energy efficient boiler. While the upfront cost may seem significant, a modern boiler can help reduce your energy bills by delivering heating and hot water more efficiently. Investing in the right type of boiler and any necessary components, like a hot water cylinder for system or regular boilers, ensures your heating system meets your household's needs both now and in the future.
            </p>
            
            <div class="bg-amber-50 border-l-4 border-amber-500 p-6 rounded-r-lg mb-6">
              <p class="text-gray-700">
                <span class="font-semibold">Transparent Quotes:</span> For an accurate idea of new boiler cost tailored to your property and requirements, it's best to request a fixed price quote. This way, you'll know exactly what to expect, with no hidden surprises, and can make an informed decision about your new boiler installation.
              </p>
            </div>
          </div>

          <!-- Quality Checks -->
          <div class="mb-12">
            <h2 class="text-3xl font-bold text-gray-900 mb-6">Quality checks after boiler installation</h2>
            
            <p class="text-gray-700 mb-6">
              Once the boiler is installed, final checks are carried out to confirm:
            </p>
            
            <div class="grid md:grid-cols-2 gap-6 mb-8">
              <div class="space-y-4">
                <div class="flex items-start">
                  <CheckCircle className="w-5 h-5 text-green-500 mr-3 mt-0.5 flex-shrink-0" />
                  <span>Stable heating and hot water delivery</span>
                </div>
                <div class="flex items-start">
                  <CheckCircle className="w-5 h-5 text-green-500 mr-3 mt-0.5 flex-shrink-0" />
                  <span>Correct system pressure and performance</span>
                </div>
              </div>
              
              <div class="space-y-4">
                <div class="flex items-start">
                  <CheckCircle className="w-5 h-5 text-green-500 mr-3 mt-0.5 flex-shrink-0" />
                  <span>Safe operation under normal use</span>
                </div>
              </div>
            </div>
            
            <p class="text-gray-700 mb-6">
              It is important to schedule an annual boiler service to maintain efficiency and keep your warranty valid. Regular boiler service also helps ensure ongoing safe operation. Boiler service cost can often be bundled with installation or maintenance plans for added convenience.
            </p>
            
            <div class="p-6 bg-green-50 rounded-lg">
              <p class="text-gray-700">
                <span class="font-semibold">Ready for Use:</span> These checks ensure the boiler is ready for everyday use immediately after installation.
              </p>
            </div>
          </div>

          <!-- Image 2: New Boiler -->
          <div class="mb-12">
            <div class="rounded-xl overflow-hidden shadow-lg mb-6">
              <Image 
                src={image3} 
                alt="New boiler installation completed" 
                width={800}
                height={450}
                class="w-full h-auto"
              />
            </div>
            <p class="text-sm text-gray-500 text-center italic">Modern, efficient boiler installation</p>
          </div>

          <!-- FAQs -->
          <div class="mb-12">
            <h2 class="text-3xl font-bold text-gray-900 mb-8 flex items-center">
              <MessageCircle className="w-8 h-8 text-blue-600 mr-3" />
              Boiler installation FAQs
            </h2>
            
            <div class="space-y-6">
              <div class="border border-gray-200 rounded-lg p-6 hover:border-blue-300 transition-colors">
                <h3 class="font-bold text-gray-900 text-lg mb-3">How do I know if I need a new boiler installation?</h3>
                <p class="text-gray-700">If your boiler struggles to meet heating or hot water demand, breaks down frequently, or no longer suits your property size, a new installation is often the correct solution. In many cases, a boiler replacement or replacement boiler is necessary when the current system is no longer efficient or reliable.</p>
              </div>
              
              <div class="border border-gray-200 rounded-lg p-6 hover:border-blue-300 transition-colors">
                <h3 class="font-bold text-gray-900 text-lg mb-3">Will the boiler be sized correctly for my home?</h3>
                <p class="text-gray-700">Yes. {serviceData.businessName} assesses usage requirements and property details to ensure the installed boiler matches actual demand. We recommend energy efficient boilers, such as an A-rated boiler or a new A-rated boiler, to ensure optimal performance and cost savings.</p>
              </div>
              
              <div class="border border-gray-200 rounded-lg p-6 hover:border-blue-300 transition-colors">
                <h3 class="font-bold text-gray-900 text-lg mb-3">Do I need to prepare my home before installation?</h3>
                <p class="text-gray-700">Clear access to the boiler location and surrounding area is usually sufficient. Any specific preparation will be explained in advance.</p>
              </div>
              
              <div class="border border-gray-200 rounded-lg p-6 hover:border-blue-300 transition-colors">
                <h3 class="font-bold text-gray-900 text-lg mb-3">Will my heating work immediately after installation?</h3>
                <p class="text-gray-700">Yes. The system is tested after installation to ensure heating and hot water are fully operational before completion.</p>
              </div>
            </div>
          </div>

          <!-- Final CTA Section -->
          <div class="mb-12">
            <h2 class="text-3xl font-bold text-gray-900 mb-6">Book a boiler installation in {serviceData.location}</h2>
            
            <div class="bg-gradient-to-r from-blue-50 to-blue-100 border-l-4 border-blue-600 p-6 rounded-r-lg">
              <p class="text-gray-800 mb-4">
                For professional boiler installations in {serviceData.location}, {serviceData.businessName} provides a clear, structured service focused on correct system matching and reliable outcomes. Get a fixed price for your installation—simply request a boiler quote or boiler quote online for maximum convenience.
              </p>
              
              <p class="text-gray-800 font-semibold">
                Contact {serviceData.businessName} today to get a new boiler with a transparent, fixed price process and ensure your heating system is installed the right way from the start.
              </p>
            </div>
          </div>
        </div>

        <!-- Sidebar -->
        <div class="space-y-8">
          <!-- Quick Contact Card -->
          <div class="bg-gradient-to-br from-blue-600 to-blue-800 text-white rounded-xl p-6 shadow-lg">
            <h3 class="text-2xl font-bold mb-4">Book Your Installation</h3>
            <p class="mb-6">Professional boiler installation for all property types</p>
            
            <a href={`tel:${serviceData.phoneNumber}`} class="inline-flex items-center justify-center w-full py-4 bg-white text-blue-600 font-bold rounded-lg hover:bg-gray-100 transition-colors mb-4">
              <Phone className="w-5 h-5 mr-3" />
              Call Now: {serviceData.phoneNumber}
            </a>
            
            <a href="/contact" class="inline-flex items-center justify-center w-full py-4 bg-transparent border-2 border-white text-white font-bold rounded-lg hover:bg-white/10 transition-colors">
              Get Fixed Price Quote
            </a>
            
            <div class="mt-6 pt-6 border-t border-white/20">
              <div class="flex items-center">
                <Shield className="w-5 h-5 mr-3" />
                <div>
                  <p class="font-semibold">Gas Safe Registered</p>
                  <p class="text-sm opacity-90">All installations compliant</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Service Details -->
          <div class="bg-gray-50 rounded-xl p-6 border border-gray-200">
            <h3 class="text-xl font-bold text-gray-900 mb-4">Service Details</h3>
            
            <div class="space-y-4">
              <div>
                <p class="font-semibold text-gray-700 mb-1">Service Type</p>
                <p class="text-gray-600">Boiler Installation</p>
